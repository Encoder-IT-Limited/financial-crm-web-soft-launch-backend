{
  "info": {
    "name": "MRM – Customers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "tenantSubdomain", "value": "acme" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const subdomain = pm.collectionVariables.get('tenantSubdomain') || pm.environment.get('tenantSubdomain');",
          "if (subdomain) pm.request.headers.upsert({ key: 'X-Tenant-Subdomain', value: subdomain });"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
  },
  "item": [
    {
      "name": "List Customers",
      "request": { "method": "GET", "url": "{{baseUrl}}/customers" }
    },
    {
      "name": "Create Customer",
      "event": [{ "listen": "test", "script": { "exec": [
        "const res = pm.response.json();",
        "if (res.success) pm.collectionVariables.set('customerId', res.data.id);"
      ]}}],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/customers",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+971501234567\",\n  \"address\": \"123 Main St, Dubai\",\n  \"taxNumber\": \"TAX123\",\n  \"creditLimit\": 10000,\n  \"openingBalance\": 0\n}"
        }
      }
    },
    {
      "name": "Get Customer",
      "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}" }
    },
    {
      "name": "Update Customer",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/customers/{{customerId}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+971509876543\",\n  \"creditLimit\": 15000\n}"
        }
      }
    }
  ]
}
