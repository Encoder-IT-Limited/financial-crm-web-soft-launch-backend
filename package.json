{
  "name": "mrm",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prisma:public:generate": "prisma generate --config prisma/public/prisma.config.ts",
    "prisma:public:migrate": "prisma migrate dev --config prisma/public/prisma.config.ts",
    "prisma:tenant:generate": "prisma generate --config prisma/tenant/prisma.config.ts",
    "prisma:tenant:migrate": "prisma migrate dev --config prisma/tenant/prisma.config.ts",
    "tenant:provision": "tsx scripts/provisionTenant.ts",
    "tenant:migrate-all": "tsx scripts/migrateAllTenants.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
