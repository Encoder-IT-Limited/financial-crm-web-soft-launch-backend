NODE_ENV=development
PORT=3000
ROOT_DOMAIN=localhost

PUBLIC_DATABASE_URL="postgresql://user:password@localhost:5432/mrm_dev"
TENANT_DATABASE_URL="postgresql://user:password@localhost:5432/mrm_dev"
# Only used by `prisma migrate dev` run interactively against the reference
# schema. src/db/migrateTenantSchema.ts overrides this per real tenant.
TENANT_MIGRATION_DATABASE_URL="postgresql://user:password@localhost:5432/mrm_dev?schema=tenant_reference"

JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
